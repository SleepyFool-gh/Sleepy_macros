    <<for _i, _effect range _list>>
        <div class='name'>
            <<print _effect.id>>
        </div>
        <div class='example hover' @data-effect='_effect.id'>
            An <span class='effect' @data-effect='_effect.id'>example</span> usage<br/><small>(hover to see)</small>
        </div>
        <div class='origin'>
            <<print _effect.origin>>
        </div>
        <div class='variables'>
            <<if _effect.variables>>
                <<for _var, _value range _effect.variables>>
                    <code>_value</code>
                    <input @data-effect='_effect.id' @data-variable='_value' type='text'>
                <</for>>
            <</if>>
        </div>
    <</for>>

</div>
<<done>>
    <<script>>
        /* run effects on hover */
        $('.example.hover').each(function() {
            $(this).hover(
                () => {
                    const $effect = $(this).find('.effect');
                    const effect = $effect.attr('data-effect');
                    $effect.addClass(effect);
                },
                () => {
                    const $effect = $(this).find('.effect');
                    const effect = $effect.attr('data-effect');
                    $effect.removeClass(effect);
                }
            );
        });
        
        /* set placeholders */
        const styles = window.getComputedStyle(document.documentElement);
        $('input').each(function(i, e) {
            const effect_name = $(e).attr('data-effect');
            const var_name = $(e).attr('data-variable');
            const default_var_name = var_name.replace('--tw-', '--tw-default-');
            const val = styles.getPropertyValue(default_var_name).trim();
            $(e).attr('placeholder', val);
        });
        /* fix blurrier */
        $('[data-effect="tw-blurrier"]').attr('placeholder', styles.getPropertyValue('--tw-default-blurrier').trim());

        /* make textfields update vars */
        $('#grid').on('input', 'input', function(e) {
            const effect_name = $(e.target).attr('data-effect');
            const var_name = $(e.target).attr('data-variable');
            const val = $(e.target).val();
            $(`.${effect_name}`).css(var_name, val);
            $(`[${effect_name}]`).css(var_name, val);

            /* fix hover textfields */
            if (effect_name.includes('tw-slide')) {
                $(`.example.hover[data-effect='${effect_name}']`).css(var_name, val);
            }
        });
    <</script>>
<</done>>


:: print [nobr]
